.help-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.help-header {
  padding: 34rpx;
  border-radius: 24rpx;
  background: #0f5c3f;
  color: #fff8e8;
  border: 8rpx solid #784b2a;
}

.help-title {
  display: block;
  font-size: 46rpx;
  font-weight: 900;
}

.help-subtitle {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 248, 232, 0.82);
  font-size: 28rpx;
  line-height: 1.5;
}

.help-section {
  padding: 26rpx;
  border-radius: 20rpx;
  background: #fffaf0;
  border: 2rpx solid rgba(49, 41, 32, 0.08);
  box-shadow: 0 12rpx 24rpx rgba(80, 62, 43, 0.08);
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #312920;
  font-size: 32rpx;
  font-weight: 900;
}

.help-line {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  color: #5d5144;
  font-size: 28rpx;
  line-height: 1.55;
  margin-top: 18rpx;
}

.badge {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #c23b32;
  color: #fffaf0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 42rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.button-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.button-note {
  min-height: 132rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f7f1e3;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  color: #6d5f4e;
  font-size: 25rpx;
  line-height: 1.4;
}

.button-name {
  color: #1f6f4a;
  font-weight: 900;
}
