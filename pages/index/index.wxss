.home-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.hero-table {
  min-height: 78vh;
  padding: 36rpx;
  border-radius: 28rpx;
  background: #0f5c3f;
  border: 10rpx solid #784b2a;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.08), 0 24rpx 48rpx rgba(58, 39, 23, 0.18);
  color: #fff8e8;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.brand-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.logo-card {
  width: 132rpx;
  height: 180rpx;
  border-radius: 18rpx;
  background: #fffaf0;
  color: #1d1712;
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 18rpx 28rpx rgba(18, 16, 14, 0.2);
}

.logo-rank {
  font-size: 42rpx;
  font-weight: 900;
}

.logo-suit {
  font-size: 56rpx;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.eyebrow {
  color: #f0d18d;
  font-size: 22rpx;
  font-weight: 800;
}

.title {
  margin-top: 8rpx;
  font-size: 58rpx;
  font-weight: 900;
}

.subtitle {
  margin-top: 12rpx;
  color: rgba(255, 248, 232, 0.82);
  font-size: 28rpx;
  line-height: 1.5;
}

.cards-fan {
  height: 300rpx;
  margin: 32rpx 0 20rpx;
  position: relative;
}

.fan-card {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 166rpx;
  height: 232rpx;
  margin-left: -83rpx;
  border-radius: 20rpx;
  background: #fffaf0;
  border: 2rpx solid rgba(45, 38, 30, 0.14);
  box-shadow: 0 18rpx 32rpx rgba(15, 24, 20, 0.22);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 48rpx;
  font-weight: 900;
}

.fan-card.red {
  color: #b63330;
}

.fan-card.black {
  color: #241f1a;
}

.fan-card-one {
  transform: translateX(-210rpx) rotate(-16deg);
}

.fan-card-two {
  transform: translateX(-70rpx) rotate(-5deg);
}

.fan-card-three {
  transform: translateX(70rpx) rotate(6deg);
}

.fan-card-four {
  transform: translateX(210rpx) rotate(16deg);
}

.score-board {
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 250, 240, 0.12);
  border: 2rpx solid rgba(255, 250, 240, 0.16);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.score-mini {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.score-label {
  color: rgba(255, 248, 232, 0.78);
  font-size: 22rpx;
}

.score-value {
  color: #f0d18d;
  font-size: 38rpx;
  font-weight: 900;
}

.home-actions {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.rule-strip {
  display: grid;
  gap: 18rpx;
}

.rule-item {
  min-height: 92rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #fffaf0;
  border: 2rpx solid rgba(49, 41, 32, 0.08);
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 12rpx 24rpx rgba(80, 62, 43, 0.08);
}

.rule-number {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #c23b32;
  color: #fffaf0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}
