.home-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hero-table {
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #0f5c3f;
  border: 4rpx solid #5a3d24;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.08), 0 16rpx 32rpx rgba(58, 39, 23, 0.14);
  color: #fff8e8;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.brand-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.logo-card {
  flex-shrink: 0;
  width: 120rpx;
  height: 164rpx;
  border-radius: 16rpx;
  background: #fffaf0;
  color: #1d1712;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 12rpx 22rpx rgba(18, 16, 14, 0.18);
}

.logo-rank {
  font-size: 38rpx;
  font-weight: 900;
}

.logo-suit {
  font-size: 48rpx;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.eyebrow {
  color: #f0d18d;
  font-size: 20rpx;
  font-weight: 800;
}

.title {
  margin-top: 6rpx;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.15;
}

.subtitle {
  margin-top: 10rpx;
  color: rgba(255, 248, 232, 0.82);
  font-size: 26rpx;
  line-height: 1.45;
}

.cards-fan {
  height: 220rpx;
  position: relative;
  overflow: visible;
}

.fan-card {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 140rpx;
  height: 196rpx;
  margin-left: -70rpx;
  border-radius: 18rpx;
  background: #fffaf0;
  border: 2rpx solid rgba(45, 38, 30, 0.12);
  box-shadow: 0 12rpx 24rpx rgba(15, 24, 20, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.fan-card.red {
  color: #b63330;
}

.fan-card.black {
  color: #241f1a;
}

.fan-card-one {
  transform: translateX(-150rpx) rotate(-12deg);
}

.fan-card-two {
  transform: translateX(-50rpx) rotate(-4deg);
}

.fan-card-three {
  transform: translateX(50rpx) rotate(4deg);
}

.fan-card-four {
  transform: translateX(150rpx) rotate(12deg);
}

.score-board {
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(255, 250, 240, 0.12);
  border: 2rpx solid rgba(255, 250, 240, 0.14);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.score-mini {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.score-label {
  color: rgba(255, 248, 232, 0.78);
  font-size: 20rpx;
}

.score-value {
  color: #f0d18d;
  font-size: 34rpx;
  font-weight: 900;
}

.home-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.home-actions .primary-button,
.home-actions .ghost-button {
  width: 100%;
  min-height: 84rpx;
  font-size: 28rpx;
}

.home-actions .ghost-button {
  background: #fffaf0;
  color: #312920;
}

.rule-strip {
  display: grid;
  gap: 12rpx;
}

.rule-item {
  min-height: 76rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #fffaf0;
  border: 2rpx solid rgba(49, 41, 32, 0.08);
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.rule-number {
  flex-shrink: 0;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #1f6f4a;
  color: #fffaf0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
}

.rule-item text:last-child {
  font-size: 26rpx;
  line-height: 1.45;
  color: #4a4036;
}
