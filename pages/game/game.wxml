<view class="page game-page">
  <view class="score-strip">
    <view class="score-cell">
      <text class="score-name">关卡</text>
      <text class="score-number">{{level}}</text>
    </view>
    <view class="score-cell">
      <text class="score-name">本局</text>
      <text class="score-number">{{sessionCorrect}}</text>
    </view>
    <view class="score-cell">
      <text class="score-name">累计</text>
      <text class="score-number">{{totalCorrect}}</text>
    </view>
    <view class="score-cell">
      <text class="score-name">最快</text>
      <text class="score-number small">{{fastestTimeText}}</text>
    </view>
    <view class="score-cell">
      <text class="score-name">用时</text>
      <text class="score-number small">{{elapsedTimeText}}</text>
    </view>
  </view>

  <view class="table-panel">
    <view class="table-head">
      <text class="table-title">目标 24</text>
      <text class="table-state {{tableStateClass}}">{{tableStateText}}</text>
    </view>

    <view class="{{operandGridClass}}">
      <view
        wx:for="{{operands}}"
        wx:key="id"
        class="operand {{item.className}}"
        bindtap="onSelect"
        data-id="{{item.id}}"
      >
        <view wx:if="{{!item.isResult}}" class="corner top-left">
          <text>{{item.label}}</text>
          <text>{{item.suit}}</text>
        </view>
        <view class="card-body">
          <view class="card-face">
            <text class="rank">{{item.label}}</text>
            <text wx:if="{{!item.isResult}}" class="suit">{{item.suit}}</text>
          </view>
          <text wx:if="{{item.isResult}}" class="result-expr">{{item.expr}}</text>
        </view>
        <view wx:if="{{!item.isResult}}" class="corner bottom-right">
          <text>{{item.label}}</text>
          <text>{{item.suit}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="{{statusPanelClass}}">
    <text>{{guideText}}</text>
  </view>

  <view class="ops-section {{opsDisabled ? 'is-disabled' : ''}}">
    <text class="section-label">四则运算</text>
    <view class="ops-grid">
      <view class="op-cell {{opsDisabled ? 'disabled' : ''}}" bindtap="onOperate" data-op="+">
        <text class="op-symbol">+</text>
        <text class="op-name">加</text>
      </view>
      <view class="op-cell {{opsDisabled ? 'disabled' : ''}}" bindtap="onOperate" data-op="-">
        <text class="op-symbol">−</text>
        <text class="op-name">减</text>
      </view>
      <view class="op-cell {{opsDisabled ? 'disabled' : ''}}" bindtap="onOperate" data-op="*">
        <text class="op-symbol">×</text>
        <text class="op-name">乘</text>
      </view>
      <view class="op-cell {{opsDisabled ? 'disabled' : ''}}" bindtap="onOperate" data-op="/">
        <text class="op-symbol">÷</text>
        <text class="op-name">除</text>
      </view>
    </view>
  </view>

  <view class="action-grid">
    <button class="ghost-button" bindtap="undo">撤销</button>
    <button class="ghost-button" bindtap="restartRound">重开</button>
    <button class="ghost-button" bindtap="showHint">提示</button>
    <button class="plain-button" bindtap="startNewRound">换一题</button>
  </view>

  <view class="move-panel" wx:if="{{moveLogs.length}}">
    <text class="move-title">步骤</text>
    <view class="move-line" wx:for="{{moveLogs}}" wx:key="*this">
      <text>{{index + 1}}.</text>
      <text>{{item}}</text>
    </view>
  </view>

  <text class="voice-link" bindtap="voiceTodo">语音输入（敬请期待）</text>
</view>
