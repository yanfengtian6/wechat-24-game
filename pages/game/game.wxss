.game-page {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-bottom: 16rpx;
}

.score-strip {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
}

.score-cell {
  min-height: 72rpx;
  padding: 8rpx 4rpx;
  border-radius: 12rpx;
  background: #fffaf0;
  border: 2rpx solid rgba(49, 41, 32, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-name {
  color: #7a6d5c;
  font-size: 18rpx;
}

.score-number {
  margin-top: 2rpx;
  color: #1f6f4a;
  font-size: 28rpx;
  font-weight: 900;
}

.score-number.small {
  font-size: 22rpx;
}

.table-panel {
  padding: 18rpx;
  border-radius: 20rpx;
  background: #0f5c3f;
  border: 4rpx solid #5a3d24;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.08);
}

.table-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.table-title {
  color: #fff8e8;
  font-size: 28rpx;
  font-weight: 900;
}

.table-state {
  min-width: 96rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 240, 0.14);
  color: #f0d18d;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
}

.table-state.state-done {
  background: rgba(31, 111, 74, 0.45);
  color: #d7f5e4;
}

.table-state.state-fail {
  background: rgba(194, 59, 50, 0.35);
  color: #ffd8d5;
}

.operand-grid {
  display: grid;
  gap: 12rpx;
  justify-items: stretch;
  align-items: stretch;
}

.grid-1 {
  grid-template-columns: 1fr;
  justify-items: center;
  min-height: 200rpx;
}

.grid-1 .operand {
  width: 300rpx;
  height: 200rpx;
}

.grid-2 {
  grid-template-columns: repeat(2, 1fr);
}

.grid-2 .operand {
  height: 168rpx;
}

.grid-3 {
  grid-template-columns: repeat(2, 1fr);
}

.grid-3 .operand {
  height: 160rpx;
}

.grid-3 .operand:nth-child(3) {
  grid-column: 1 / -1;
  width: 52%;
  justify-self: center;
}

.grid-4 {
  grid-template-columns: repeat(2, 1fr);
}

.grid-4 .operand {
  height: 156rpx;
}

.operand {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  background: #fffaf0;
  border: 4rpx solid transparent;
  color: #241f1a;
  box-shadow: 0 8rpx 18rpx rgba(15, 24, 20, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.operand.red {
  color: #b63330;
}

.operand.selected {
  border-color: #f0d18d;
  box-shadow: 0 0 0 4rpx rgba(240, 209, 141, 0.35), 0 8rpx 18rpx rgba(15, 24, 20, 0.16);
}

.operand.result {
  background: #fff5db;
}

.card-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  max-width: 100%;
}

.corner {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.05;
}

.top-left {
  top: 10rpx;
  left: 12rpx;
}

.bottom-right {
  right: 12rpx;
  bottom: 10rpx;
  transform: rotate(180deg);
}

.card-face {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.rank {
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
}

.grid-1 .rank {
  font-size: 72rpx;
}

.suit {
  font-size: 40rpx;
  line-height: 1;
}

.result-expr {
  color: #6d5f4e;
  font-size: 20rpx;
  line-height: 1.35;
  word-break: break-all;
  text-align: center;
}

.hint-bar {
  min-height: 56rpx;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  background: #fffaf0;
  color: #5d5144;
  border-left: 6rpx solid #1f6f4a;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  line-height: 1.4;
}

.hint-bar.success {
  border-left-color: #1f6f4a;
  color: #1f6f4a;
  font-weight: 700;
}

.hint-bar.fail {
  border-left-color: #c23b32;
  color: #9a2f28;
  font-weight: 700;
}

.ops-section {
  padding: 12rpx;
  border-radius: 16rpx;
  background: #fffaf0;
  border: 2rpx solid rgba(49, 41, 32, 0.08);
}

.ops-section.is-disabled {
  opacity: 0.72;
}

.section-label {
  display: block;
  margin-bottom: 10rpx;
  color: #7a6d5c;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

.ops-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.op-cell {
  height: 80rpx;
  border-radius: 14rpx;
  background: #1f6f4a;
  color: #fffaf0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.op-cell:active {
  opacity: 0.88;
}

.op-cell.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.op-symbol {
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.op-name {
  font-size: 18rpx;
  font-weight: 700;
  opacity: 0.9;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
}

.action-grid .ghost-button,
.action-grid .plain-button {
  width: 100%;
  min-height: 68rpx;
  font-size: 26rpx;
}

.move-panel {
  max-height: 120rpx;
  overflow-y: auto;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 250, 240, 0.86);
  border: 2rpx solid rgba(49, 41, 32, 0.06);
}

.move-title {
  display: block;
  margin-bottom: 6rpx;
  color: #7a6d5c;
  font-size: 20rpx;
  font-weight: 700;
}

.move-line {
  display: flex;
  gap: 8rpx;
  color: #6d5f4e;
  font-size: 20rpx;
  line-height: 1.4;
}

.voice-link {
  display: block;
  margin-top: 4rpx;
  color: #7a6d5c;
  font-size: 22rpx;
  text-align: center;
  text-decoration: underline;
}
